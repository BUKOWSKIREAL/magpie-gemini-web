{
  "name": "magpie-gemini-web",
  "version": "0.6.0",
  "description": "Gemini Web and Google AI Studio provider for Magpie, backed by gemini-web2api-go and AIStudio2API",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BUKOWSKIREAL/magpie-gemini-web.git"
  },
  "homepage": "https://github.com/BUKOWSKIREAL/magpie-gemini-web#readme",
  "bugs": {
    "url": "https://github.com/BUKOWSKIREAL/magpie-gemini-web/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "index.mjs",
    "lib/",
    "scripts/backend.mjs",
    "scripts/backend-argon.mjs",
    "scripts/backend-release.mjs",
    "scripts/studio-smoke.mjs",
    "scripts/studio.mjs",
    "scripts/studio-release.mjs",
    "scripts/studio-archive.go",
    "scripts/studio-regzip.go",
    "scripts/studio-managed-smoke.mjs",
    "patches/",
    "native-task/lib/",
    "native-task/bridge/",
    "native-task/scripts/bridge.mjs",
    "native-task/requirements.txt",
    "native-task/pyproject.toml",
    "native-task/README.md",
    "native-task/LICENSE",
    "README.md",
    "README.en.md",
    "docs/logo.svg",
    "docs/backend-release.md",
    "docs/studio-release.md",
    "LICENSE",
    "LICENSE-UPSTREAM",
    "LICENSE-AISTUDIO"
  ],
  "keywords": [
    "magpie-plugin",
    "opencode-plugin",
    "opencode",
    "provider",
    "gemini",
    "gemini-web",
    "ai-studio",
    "google-ai-studio"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs native-task/test/*.test.mjs",
    "backend:install": "node scripts/backend.mjs install",
    "backend:install:upstream": "node scripts/backend.mjs install-upstream",
    "backend:release:build": "node scripts/backend-release.mjs --verify",
    "backend:start": "node scripts/backend.mjs start",
    "backend:status": "node scripts/backend.mjs status",
    "backend:build:argon": "node scripts/backend-argon.mjs build",
    "backend:install:argon": "node scripts/backend-argon.mjs install",
    "backend:start:argon": "node scripts/backend-argon.mjs start",
    "studio:release:build": "node scripts/studio-release.mjs --verify",
    "studio:managed:smoke": "node scripts/studio-managed-smoke.mjs",
    "studio:install": "node scripts/studio.mjs install",
    "studio:start": "node scripts/studio.mjs start",
    "studio:status": "node scripts/studio.mjs status",
    "studio:stop": "node scripts/studio.mjs stop",
    "studio:login": "node scripts/studio.mjs login",
    "studio:relogin": "node scripts/studio.mjs relogin",
    "studio:smoke": "node scripts/studio-smoke.mjs"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 1
  }
}

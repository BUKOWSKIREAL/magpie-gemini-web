+// 后台重取失败时必须作废缓存，否则失效的号会一直拿着旧 token 被当成可用。
+func TestRefreshAppTokensFailureDropsCache(t *testing.T) {
+	cookie := "SAPISID=sap2; __Secure-1PSID=psid2"
+	xsrfMu.Lock()
+	xsrfCache[cookieKey(cookie)] = xsrfEntry{token: "stale", fetched: time.Now()}
+	xsrfMu.Unlock()
+	t.Cleanup(func() { invalidateXSRF(cookie) })
+
+	refreshAppTokens(cookieKey(cookie), cookie, "http://127.0.0.1:1")
+	xsrfMu.Lock()
+	_, ok := xsrfCache[cookieKey(cookie)]
+	xsrfMu.Unlock()
+	if ok {
+		t.Fatal("重取失败后缓存仍在")
+	}
+}

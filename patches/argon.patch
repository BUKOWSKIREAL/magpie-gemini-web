+// countingReader 按块吐数据并记录被读了几次。
+type countingReader struct {
+	chunks [][]byte
+	reads  int
+}
+
+func (r *countingReader) Read(p []byte) (int, error) {
+	if r.reads >= len(r.chunks) {
+		return 0, io.EOF
+	}
+	n := copy(p, r.chunks[r.reads])
+	r.reads++
+	return n, nil
+}

+// lineHandler 是每读到一行上游数据时的处理：推思考链、推正文增量、判断能否提前收尾。
+//
+// tracker / rtracker 记的是**已经发给客户端的**正文 / 思考链，调用方据此决定还能
+// 不能重试（吐过内容就不能重试，否则重复）。非流式也要逐帧看正文才能判断能否提前
+// 收尾，所以没有 onDelta 时另用一份 watch 记，不污染 tracker。
+type lineHandler struct {
+	tracker, rtracker *deltaTracker
+	stop              atomic.Bool
+	cb                func(string) // nil 表示不需要逐行处理
+}
+
+func newLineHandler(onDelta, onReasoning func(string), stopWhen func(string) bool) *lineHandler {
+	lh := &lineHandler{tracker: &deltaTracker{}, rtracker: &deltaTracker{}}
+	if onDelta == nil && onReasoning == nil && stopWhen == nil {
+		return lh
+	}
+	watch := lh.tracker
+	if onDelta == nil {
+		watch = &deltaTracker{}
+	}
+	lh.cb = func(line string) {
+		// 思考链先推完才轮到正文，所以先处理它，客户端拿到的顺序才对。
+		if onReasoning != nil {
+			if r := reasoningInLine(line); r != "" {
+				if d := lh.rtracker.Push(r); d != "" {
+					onReasoning(d)
+				}
+			}
+		}
+		if onDelta == nil && stopWhen == nil {
+			return
+		}
+		grew := false
+		for _, t := range textsInLine(line) {
+			if d := watch.Push(t); d != "" {
+				grew = true
+				if onDelta != nil {
+					onDelta(d)
+				}
+			}
+		}
+		if grew && stopWhen != nil && stopWhen(watch.emitted) {
+			lh.stop.Store(true)
+		}
+	}
+	return lh
+}

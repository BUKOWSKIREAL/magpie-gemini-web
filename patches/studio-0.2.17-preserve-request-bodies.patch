@@ -0,0 +1,73 @@
+package requestdb
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+
+	"github.com/Mag1cFall/AIStudio2API/internal/sqlitedb"
+)
+
+func TestLegacyBodiesMigration(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "requests.db")
+	db, err := sqlitedb.Open(file, `CREATE TABLE bodies (seq INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT NOT NULL UNIQUE, time INTEGER NOT NULL, request TEXT NOT NULL, request_size INTEGER NOT NULL, response TEXT NOT NULL, response_size INTEGER NOT NULL);
+INSERT INTO bodies (id,time,request,request_size,response,response_size) VALUES ('old',1234,'旧请求',100,'reply',200);`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	for round := range 2 {
+		store, err := Open(file, func(string, string) {})
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, err := store.RequestBody(context.Background(), "old")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if body.Request != "旧请求" || body.Response != "reply" || body.RequestSize != 100 || body.ResponseSize != 200 || body.Time.UnixMilli() != 1234 {
+			t.Fatalf("changed body: %+v", body)
+		}
+		var old int
+		if err := store.db.QueryRow(`SELECT COUNT(*) FROM sqlite_master WHERE name='bodies'`).Scan(&old); err != nil || old != 0 {
+			t.Fatalf("old table: %d, %v", old, err)
+		}
+		if round == 0 {
+			// A retry must keep an already migrated body over a stale legacy copy.
+			if _, err := store.db.Exec(`CREATE TABLE bodies (seq INTEGER, id TEXT, time INTEGER, request TEXT, request_size INTEGER, response TEXT, response_size INTEGER);
+INSERT INTO bodies VALUES (1,'old',9999,'stale',1,'stale',1);`); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := store.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestLegacyBodiesMigrationRollback(t *testing.T) {
+	db, err := sqlitedb.Open(filepath.Join(t.TempDir(), "requests.db"), schema)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err := db.Exec(`CREATE TABLE bodies (seq INTEGER, id TEXT, time INTEGER, request TEXT, request_size INTEGER, response TEXT, response_size INTEGER);
+INSERT INTO bodies VALUES (1,'good',1234,'request',1,'reply',1),(2,'bad',1234,NULL,1,'reply',1);`); err != nil {
+		t.Fatal(err)
+	}
+	if err := migrateLegacyBodies(db); err == nil {
+		t.Fatal("expected invalid legacy row to fail")
+	}
+	var old, migrated int
+	if err := db.QueryRow(`SELECT COUNT(*) FROM bodies`).Scan(&old); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow(`SELECT COUNT(*) FROM request_bodies`).Scan(&migrated); err != nil {
+		t.Fatal(err)
+	}
+	if old != 2 || migrated != 0 {
+		t.Fatalf("migration was not atomic: old=%d new=%d", old, migrated)
+	}
+}

diff --git a/internal/config/managed_test.go b/internal/config/managed_test.go
new file mode 100644
index 0000000..c5d9991
--- /dev/null
+++ b/internal/config/managed_test.go
@@ -0,0 +1,70 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func managedConfigForTest(t *testing.T) {
+	t.Helper()
+	previous := managedBy
+	managedBy = "magpie-gemini-web"
+	t.Cleanup(func() { managedBy = previous })
+}
+
+func TestManagedConfigPreservesLegacyChoices(t *testing.T) {
+	managedConfigForTest(t)
+	path := filepath.Join(t.TempDir(), ".env")
+	cfg := Default()
+	cfg.FirstEventHedge = FirstEventHedgeOff
+	cfg.RequestTimeout = 5 * time.Minute
+	cfg.UpstreamChannels = []string{"playground", "build"}
+	if err := writeEnv(path, cfg.envValues()); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(before) != string(after) || loaded.FirstEventHedge != FirstEventHedgeOff || loaded.RequestTimeout != 5*time.Minute || len(loaded.UpstreamChannels) != 2 {
+		t.Fatal("managed startup rewrote the distributor's saved choices")
+	}
+}
+
+func TestManagedSaveKeepsDefaultsExplicitAndEnvironmentLocked(t *testing.T) {
+	managedConfigForTest(t)
+	path := writeTestEnv(t, "LISTEN_ADDR=127.0.0.1:2049\n")
+	t.Setenv("LISTEN_ADDR", "127.0.0.1:2051")
+	saved, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	update := Default().KeepEnvironment(saved)
+	if err := update.Save(path); err != nil {
+		t.Fatal(err)
+	}
+	text := readTestEnv(t, path)
+	for _, want := range []string{"WARM_WORKER_LIMIT=10\n", "MAX_ACTIVE_WORKERS=20\n", "SEARCH_MODEL_ALIASES=true\n", "PER_ACCOUNT_CONCURRENCY=2\n", "ROUTING_STRATEGY=round-robin\n", "FIRST_EVENT_HEDGE=auto\n", "STRIP_THOUGHT_SIGNATURES=false\n", "LISTEN_ADDR=127.0.0.1:2049\n"} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("saved config is missing %q", want)
+		}
+	}
+	loaded, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.ListenAddr != "127.0.0.1:2051" || loaded.FirstEventHedge != FirstEventHedgeAuto || !loaded.SearchModelAliases || loaded.PerAccountConcurrency != 2 || loaded.RoutingStrategy != "round-robin" {
+		t.Fatal("managed settings changed across save/load")
+	}
+}


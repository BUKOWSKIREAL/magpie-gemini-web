+// managedBy is set at link time by a distributor that owns configuration defaults.
+// Its saved values must remain explicit so a missing default cannot be mistaken
+// for a setting the distributor still needs to initialize.
+var managedBy string
+
 // LogFileMB 是单个日志文件的轮转大小
 const LogFileMB = 10
 
@@ -412,7 +417,7 @@ func Load(path string) (Config, error) {
 	if err != nil {
 		return Config{}, err
 	}
-	if !commented && upgradeEnv(values) {
+	if managedBy == "" && !commented && upgradeEnv(values) {
 		if err := writeEnv(path, values); err != nil {
 			return Config{}, err
 		}
@@ -576,8 +581,8 @@ func (c Config) Save(path string) error {
 			if inFile {
 				file[key] = saved[key]
 			}
-		case slices.Contains(workerDefaultKeys, key) && !inFile && values[key] == previousDefaults[key]:
-		case values[key] != defaults[key]:
+		case managedBy == "" && slices.Contains(workerDefaultKeys, key) && !inFile && values[key] == previousDefaults[key]:

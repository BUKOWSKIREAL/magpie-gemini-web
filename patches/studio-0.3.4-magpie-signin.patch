+/// <reference types="node" />
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { parseMagpieSignIn, magpieTaskComplete } from '../src/magpie.ts'
+
+const client = 'a'.repeat(48)
+const callback = `http://127.0.0.1:12345/${'b'.repeat(48)}/finish`
+const fragment = (url = callback) =>
+  '#' + new URLSearchParams({ magpie: client, callback: url, deadline: String(Date.now() + 60000) })
+
+void test('accepts only a local callback and preserves sign-in state across reloads', () => {
+  const hash = fragment()
+  const signIn = parseMagpieSignIn(hash)!
+  assert.equal(signIn.callback, callback)
+  assert.equal(signIn.client, client)
+  assert.deepEqual(parseMagpieSignIn(hash), signIn)
+  for (const url of [
+    'https://evil.example',
+    'http://localhost:12345/x',
+    callback + '?key=secret',
+    callback.replace('/finish', '/api/auth'),
+    callback.replace('127.0.0.1', 'user@127.0.0.1'),
+  ]) {
+    assert.equal(parseMagpieSignIn(fragment(url)), null)
+  }
+})
+
+void test('only a fully successful task from this page completes login', () => {
+  const signIn = parseMagpieSignIn(fragment())!
+  const task = {
+    id: 'task',
+    kind: 'cookies' as const,
+    client_id: client,
+    state: 'done' as const,
+    started_at: '',
+    items: [{ account_id: 'one', label: 'One', state: 'done' as const }],
+  }
+  assert.equal(magpieTaskComplete(task, signIn), true)
+  assert.equal(magpieTaskComplete({ ...task, client_id: 'other' }, signIn), false)
+  assert.equal(magpieTaskComplete({ ...task, client_id: undefined }, signIn), false)
+  assert.equal(magpieTaskComplete({ ...task, state: 'running' }, signIn), false)
+  assert.equal(
+    magpieTaskComplete(
+      { ...task, state: 'failed', items: [...task.items, { label: 'Two', state: 'failed' }] },
+      signIn,
+    ),
+    false,
+  )
+  assert.equal(magpieTaskComplete({ ...task, items: [] }, signIn), false)
+  assert.equal(magpieTaskComplete(task, { ...signIn, account: 'two' }), false)
+})

diff --git a/web/src/magpie.ts b/web/src/magpie.ts
new file mode 100644
index 0000000..84e1f2b
--- /dev/null
+++ b/web/src/magpie.ts
@@ -0,0 +1,59 @@
+import type { AccountTask } from './types'
+
+interface MagpieSignIn {
+  client: string
+  callback: string
+  account: string
+  deadline: number
+}
+
+// The fragment is local sign-in state, never an API key or a Google credential. Keep it in the
+// URL across reloads; it is not sent to the service or in HTTP referrers.
+export function parseMagpieSignIn(hash: string): MagpieSignIn | null {
+  const params = new URLSearchParams(hash.replace(/^#/, ''))
+  const client = params.get('magpie') || ''
+  if (!/^[a-f0-9]{48}$/.test(client)) return null
+  try {
+    const callback = new URL(params.get('callback') || '')
+    const deadline = Number(params.get('deadline'))
+    if (
+      callback.protocol !== 'http:' ||
+      callback.hostname !== '127.0.0.1' ||
+      !callback.port ||
+      callback.username ||
+      callback.password ||
+      callback.search ||
+      callback.hash ||
+      !/^\/[a-f0-9]{48}\/finish$/.test(callback.pathname) ||
+      !Number.isSafeInteger(deadline) ||
+      deadline <= 0 ||
+      deadline > Date.now() + 10 * 60 * 1000
+    )
+      return null
+    return { client, callback: callback.href, account: params.get('account') || '', deadline }
+  } catch {
+    return null
+  }
+}
+
+export const magpieSignIn =
+  typeof window === 'undefined' ? null : parseMagpieSignIn(window.location.hash)
+
+export function magpieTaskComplete(task: AccountTask, signIn = magpieSignIn): boolean {
+  return (
+    !!signIn &&
+    task.client_id === signIn.client &&
+    task.state === 'done' &&
+    task.items.length > 0 &&
+    task.items.every(
+      (item) =>
+        item.state === 'done' &&
+        !!item.account_id &&
+        (!signIn.account || item.account_id === signIn.account),
+    )
+  )
+}
+
+export function returnToMagpie(cancel = false): void {
+  if (magpieSignIn) window.location.replace(magpieSignIn.callback + (cancel ? '#cancel' : ''))
+}

+++ b/internal/api/magpie_signin_test.go
@@ -0,0 +1,46 @@
+package api
+
+import (
+	"context"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestMagpieTaskCorrelation(t *testing.T) {
+	for _, client := range []string{strings.Repeat("a", 48), "", "not-a-client-id"} {
+		tasks := &accountTasks{}
+		request := httptest.NewRequest("POST", "/api/accounts", nil)
+		request.Header.Set("X-Magpie-Signin", client)
+		release := make(chan struct{})
+		task := tasks.start(request, AccountTask{Kind: "login", Items: []AccountTaskItem{{State: "pending"}}}, func(ctx context.Context, update accountTaskUpdate) {
+			<-release
+			runAccountTaskItems(ctx, update, 1, func(int) (AdminAccount, error) {
+				return AdminAccount{ID: "canonical-id", Label: "display@example.com"}, nil
+			})
+		})
+		expected := ""
+		if len(client) == 48 {
+			expected = client
+		}
+		if task.ClientID != expected {
+			t.Fatalf("client = %q, want %q", task.ClientID, expected)
+		}
+		close(release)
+		deadline := time.Now().Add(time.Second)
+		for {
+			saved := tasks.list()[0]
+			if saved.State == "done" {
+				if saved.ClientID != expected || saved.Items[0].AccountID != "canonical-id" || saved.Items[0].Label != "display@example.com" {
+					t.Fatalf("task identity lost: %#v", saved)
+				}
+				break
+			}
+			if time.Now().After(deadline) {
+				t.Fatal("task did not complete")
+			}
+			time.Sleep(time.Millisecond)
+		}
+	}
+}

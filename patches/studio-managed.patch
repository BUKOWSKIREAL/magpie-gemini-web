diff --git a/internal/app/update_managed_test.go b/internal/app/update_managed_test.go
new file mode 100644
index 0000000..ce86d14
--- /dev/null
+++ b/internal/app/update_managed_test.go
@@ -0,0 +1,41 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestManagedUpdaterCannotUpdateOrRestart(t *testing.T) {
+	executable := filepath.Join(t.TempDir(), "aistudio2api.exe")
+	original := []byte("existing executable")
+	if err := os.WriteFile(executable, original, 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, version := range []string{"v0.2.13", "v0.2.13-magpie.1", "(devel)"} {
+		t.Run(version, func(t *testing.T) {
+			u := newSelfUpdater(version, executable,
+				func() string { t.Fatal("must not query network proxy"); return "" },
+				func(string, string) { t.Fatal("must not enter the updater") },
+				func() { t.Fatal("must not restart") })
+			for _, refresh := range []bool{false, true} {
+				status, err := u.UpdateStatus(context.Background(), refresh)
+				if err != nil || status.Mode != "managed" || status.Available || status.Updating || status.Latest != "" || status.Current != version {
+					t.Fatalf("unexpected status: %+v, %v", status, err)
+				}
+			}
+			_, err := u.ApplyUpdate(context.Background())
+			var httpError interface{ HTTPStatus() int }
+			if !errors.As(err, &httpError) || httpError.HTTPStatus() != http.StatusForbidden {
+				t.Fatalf("expected forbidden: %v", err)
+			}
+			data, err := os.ReadFile(executable)
+			if err != nil || string(data) != string(original) {
+				t.Fatalf("executable changed: %v", err)
+			}
+		})
+	}
+}
